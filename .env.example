# ============================================================
# Propto — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o arquivo real.
# ============================================================

# ---------- Supabase (público — protegido por RLS) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Supabase (privado — workers e Edge Functions) ----------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_PROJECT_REF=

# ---------- AI Gateway (consumido por workers) ----------
AI_GATEWAY_URL=http://localhost:8787
AI_GATEWAY_API_KEY=
AI_GATEWAY_PRODUCT=propto

# ---------- Provedores de IA — SOMENTE em services/ai-gateway ----------
# Estas chaves não podem existir em apps/* nem em supabase/functions/*
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# ---------- Política padrão de modelos do gateway ----------
AI_MODEL_TRANSCRIBE=whisper-1
AI_MODEL_EXTRACT=claude-sonnet-4-5
AI_MODEL_WRITE=claude-sonnet-4-5
AI_MODEL_VISION=gemini-2.0-flash
AI_MODEL_COMPLIANCE=claude-sonnet-4-5
AI_MODEL_EMBED=text-embedding-3-small
# De onde o gateway aceita baixar áudio e imagem. Vazio = qualquer host
# público (só desenvolvimento). Em produção, liste o host do storage:
# sem lista, uma URL vinda do cliente alcança serviço interno da nuvem.
AI_ASSET_ALLOWED_HOSTS=
AI_MAX_ASSET_BYTES=104857600
AI_DAILY_COST_CAP_USD=50
AI_REQUEST_TIMEOUT_MS=45000
AI_CACHE_SIMILARITY_THRESHOLD=0.97

# ---------- Criptografia e privacidade ----------
ENCRYPTION_KEY=            # 32 bytes em base64 — AES-256-GCM para CPF/CNPJ
SESSION_HASH_SALT=         # rotação mensal — property_views

# ---------- Aplicação ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000

# ---------- Observabilidade ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# ---------- Anti-abuso (formulário público) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- SMS / OTP (decidir P-01 no Sprint 1) ----------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# ---------- Pagamento (decidir P-03 no Sprint 6) ----------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------- Mapas / CEP ----------
NEXT_PUBLIC_MAPS_API_KEY=
CEP_API_URL=https://viacep.com.br/ws

# ---------- Workers ----------
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=2000
MEDIA_MAX_DIMENSION=1600
MEDIA_WATERMARK_ENABLED=false
