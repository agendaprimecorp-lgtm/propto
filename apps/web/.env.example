# ------------------------------------------------------------------
# apps/web — página pública do imóvel
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# ------------------------------------------------------------------

# Conexão do papel `propto_public` (criado na migration 0007).
# Este papel só enxerga as views públicas e só executa record_property_event
# e submit_lead. NÃO use aqui a senha do postgres nem a service_role:
# a página pública é a superfície mais exposta do sistema.
#
# No Supabase, crie a senha do papel uma vez:
#   alter role propto_public with login password '...';
# e monte a string com o host do pooler do projeto:
# Atenção ao usuário: no pooler do Supabase o papel leva o código do projeto
# colado com um ponto — `propto_public.SEUPROJETO`, e não só `propto_public`.
PUBLIC_DB_URL=postgresql://propto_public.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Endereço público do site — entra no sitemap, no canonical e no JSON-LD.
NEXT_PUBLIC_SITE_URL=https://propto.com.br

# Sal do hash de sessão. Troque em produção e guarde fora do repositório.
# Trocar o sal desliga a ligação entre visitas antigas e novas — que é o efeito
# desejado: nenhum visitante é rastreável entre períodos.
SESSION_HASH_SALT=troque-este-valor

# Base pública das imagens tratadas (bucket `public` do Storage).
# Sem esta variável a página funciona e mostra espaços reservados no lugar
# das fotos — útil antes de o Storage existir.
# O bucket se chama `public` (criado pela migration 0006), por isso o caminho
# tem "public" duas vezes — está certo assim.
NEXT_PUBLIC_STORAGE_URL=https://SEUPROJETO.supabase.co/storage/v1/object/public/public

# ------------------------------------------------------------
# Painel do corretor
#
# A chave `anon` e publica por definicao: ela nao da acesso a nada sozinha.
# Quem decide o que o painel enxerga e o JWT do corretor somado as politicas
# de RLS. A `service_role` NAO entra neste app — nem aqui, nem em runtime.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEUPROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Para onde o link magico volta. Sem isto, a URL e montada a partir do
# cabecalho Host — o que deixaria um atacante escolher o destino do link.
# NEXT_PUBLIC_SITE_URL ja aparece acima e serve aos dois propositos.
