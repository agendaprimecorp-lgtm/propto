{
  "name": "propto",
  "version": "0.1.0",
  "private": true,
  "description": "Propto — sistema operacional do corretor de imóveis",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@propto/web --filter=@propto/admin",
    "dev:mobile": "turbo run start --filter=@propto/mobile",
    "dev:gateway": "turbo run dev --filter=@propto/ai-gateway",
    "dev:workers": "turbo run dev --filter=./services/*-worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "test:rls": "node tests/rls/run.mjs",
    "test:ai": "vitest run --config tests/ai/vitest.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset && pnpm db:seed",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.ts",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,sql}\"",
    "prepare": "husky",
    "db:seed": "psql \"$SUPABASE_DB_URL\" -f supabase/seed/seed_dev.sql",
    "check:schema": "node scripts/check-rls-coverage.mjs && node scripts/check-transition-parity.mjs",
    "test:queue": "node tests/queue/run.mjs",
    "test:db": "pnpm test:rls && pnpm test:queue && pnpm check:schema",
    "test:gateway": "pnpm --filter @propto/ai-gateway test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:gateway && pnpm test:media && pnpm test:db && pnpm --filter @propto/web typecheck",
    "test:media": "pnpm --filter @propto/media-worker test",
    "demo": "node -e \"const{spawn}=require('child_process');const f=require('path').resolve('apps/demo/index.html');const c=process.platform==='win32'?'start':process.platform==='darwin'?'open':'xdg-open';spawn(c,[f],{shell:true,detached:true});console.log('Demonstração aberta:',f)\"",
    "site": "npx --yes serve site -l 4321",
    "web": "npm --prefix apps/web run dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "supabase": "^1.200.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,sql}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
